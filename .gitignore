# -------- Core OS / Logs --------
.DS_Store
*.log
logs/
tmp/

# -------- Node / JS Artifacts --------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
*.tgz

# Next.js
.next/
out/

# Common bundlers / tools
dist/
build/
coverage/
.nyc_output/
.vite/
web_modules/
.cache/
.parcel-cache/
.docusaurus/

# Yarn v3 (keep required subdirs only)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# -------- Python (for backend/worker) --------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# -------- IDE --------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# -------- Docker / Local Overrides --------
docker-compose.override.yml

# -------- Prisma --------
prisma/.env

# -------- ENV / Secrets (Monorepo-wide) --------
# Block at root
.env
.env.*
!.env.example

# Block everywhere in subfolders (apps, services, infra, prisma, docs, etc.)
**/.env
**/.env.*
!**/.env.example

# Next.js guidance: .env* must not be committed
# (Next.js loads .env*, .env.local, .env.development, .env.production, etc.)
